generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions"]
  engineType       = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "public")]
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum FirmType {
  LEGAL
  CONSULTING
  HYBRID
  CA
}

enum FirmVertical {
  LEGAL
  CONSULTING
  CA
}

enum UserRole {
  ADMIN
  PARTNER
  ASSOCIATE
  ANALYST
  READONLY
}

enum MatterType {
  LEGAL
  CONSULTING
}

enum MatterStatus {
  ACTIVE
  CLOSED
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum AnalysisType {
  CONTRACT_RISK
  COMPARISON
  REDLINE
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum BriefStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DraftType {
  EMAIL
  MEMO
  REPORT
}

enum DraftStatus {
  DRAFT
  REVIEWING
  FINALIZED
}

enum MeetingSource {
  ZOOM
  TEAMS
  MEET
  UPLOAD
}

enum MeetingStatus {
  PENDING
  PROCESSING
  COMPLETED
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum JobType {
  DOCUMENT_PARSE
  ANALYSIS_RUN
  BRIEF_GENERATE
  MEETING_PROCESS
  DRAFT_GENERATE
  CHUNK_EMBED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ─── CA Vertical Enums ──────────────────────────────────────────────────────

enum EngagementType {
  GST_FILING
  INCOME_TAX_FILING
  ROC_FILING
  TDS_FILING
  AUDIT
  BOOKKEEPING
  RECONCILIATION
  ADVISORY
}

enum EngagementStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
  TERMINATED
}

enum FilingType {
  GSTR_1
  GSTR_3B
  GSTR_9
  GSTR_9C
  ITR_1
  ITR_2
  ITR_3
  ITR_4
  ITR_5
  ITR_6
  ITR_7
  TDS_RETURN
  AOC_4
  MGT_7
  DIR_3_KYC
  E_INVOICE
  E_WAY_BILL
  UDIN
}

enum FilingStatus {
  DRAFT
  PARTNER_REVIEW
  READY_TO_FILE
  FILED
  REJECTED
  OVERDUE
}

enum ComplianceItemType {
  GST_RETURN
  INCOME_TAX_RETURN
  TDS_RETURN
  ROC_FILING
  AUDIT_REPORT
  TAX_AUDIT
  GST_AUDIT
  UDIN_GENERATION
}

enum ComplianceStatus {
  UPCOMING
  DUE_THIS_WEEK
  OVERDUE
  COMPLETED
}

enum ReconciliationStatus {
  PENDING
  PROCESSING
  COMPLETED
  REVIEW_REQUIRED
  FAILED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Firm {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String
  slug                String    @unique
  firmType            FirmType  @default(LEGAL) @map("firm_type")
  firmVertical        FirmVertical @default(LEGAL) @map("firm_vertical")
  onboardingCompleted Boolean   @default(false) @map("onboarding_completed")
  plan                String    @default("free")
  seatCount           Int       @default(5) @map("seat_count")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  users          User[]
  matters        Matter[]
  documents      Document[]
  documentChunks DocumentChunk[]
  analyses       Analysis[]
  researchBriefs ResearchBrief[]
  drafts         Draft[]
  meetings       Meeting[]
  kbQueries      KbQuery[]
  auditLogs      AuditLog[]
  playbooks      Playbook[]
  jobs           Job[]

  // CA vertical
  clients             Client[]
  engagements         Engagement[]
  filings             Filing[]
  complianceItems     ComplianceItem[]
  reconciliations     Reconciliation[]
  dscKeys             DSCKey[]

  @@map("firms")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  firmId       String    @map("firm_id") @db.Uuid
  email        String    @unique
  name         String
  passwordHash String?   @map("password_hash")
  role         UserRole  @default(READONLY)
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  firm           Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  sessions       Session[]
  accounts       Account[]
  createdMatters Matter[]           @relation("MatterCreatedBy")
  uploadedDocs   Document[]         @relation("DocumentUploadedBy")
  createdBriefs  ResearchBrief[]    @relation("BriefCreatedBy")
  createdDrafts  Draft[]            @relation("DraftCreatedBy")
  kbQueries      KbQuery[]          @relation("KbQueryCreatedBy")
  auditLogs      AuditLog[]
  actionItems    MeetingActionItem[] @relation("ActionItemOwner")

  @@index([firmId])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Matter {
  id          String       @id @default(uuid()) @db.Uuid
  firmId      String       @map("firm_id") @db.Uuid
  name        String
  description String?
  type        MatterType   @default(LEGAL)
  status      MatterStatus @default(ACTIVE)
  clientName  String       @map("client_name")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  createdById String       @map("created_by_id") @db.Uuid

  firm           Firm            @relation(fields: [firmId], references: [id], onDelete: Cascade)
  createdBy      User            @relation("MatterCreatedBy", fields: [createdById], references: [id])
  documents      Document[]
  researchBriefs ResearchBrief[]
  drafts         Draft[]
  meetings       Meeting[]
  kbQueries      KbQuery[]

  @@index([firmId])
  @@index([status])
  @@map("matters")
}

model Document {
  id           String         @id @default(uuid()) @db.Uuid
  firmId       String         @map("firm_id") @db.Uuid
  matterId     String?        @map("matter_id") @db.Uuid
  filename     String
  originalName String         @map("original_name")
  mimeType     String         @map("mime_type")
  sizeBytes    Int            @map("size_bytes")
  r2Key        String         @map("r2_key")
  status       DocumentStatus @default(UPLOADED)
  uploadedById String         @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  firm      Firm             @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matter    Matter?          @relation(fields: [matterId], references: [id], onDelete: SetNull)
  uploadedBy User            @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  chunks    DocumentChunk[]
  analyses  Analysis[]

  @@index([firmId])
  @@index([matterId])
  @@index([status])
  @@map("documents")
}

model DocumentChunk {
  id           String @id @default(uuid()) @db.Uuid
  documentId   String @map("document_id") @db.Uuid
  firmId       String @map("firm_id") @db.Uuid
  chunkIndex   Int    @map("chunk_index")
  text         String
  sectionTitle String?  @map("section_title")
  pageNumber   Int?     @map("page_number")
  embedding    Unsupported("vector(768)")
  metadata     Json   @default("{}")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  firm     Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([firmId])
  @@map("document_chunks")
}

model Analysis {
  id          String         @id @default(uuid()) @db.Uuid
  documentId  String         @map("document_id") @db.Uuid
  firmId      String         @map("firm_id") @db.Uuid
  type        AnalysisType
  status      AnalysisStatus @default(PENDING)
  result      Json?
  modelUsed   String?        @map("model_used")
  createdAt   DateTime       @default(now()) @map("created_at")
  completedAt DateTime?      @map("completed_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  firm     Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([firmId])
  @@index([status])
  @@map("analyses")
}

model ResearchBrief {
  id          String      @id @default(uuid()) @db.Uuid
  matterId    String      @map("matter_id") @db.Uuid
  firmId      String      @map("firm_id") @db.Uuid
  title       String
  query       String
  status      BriefStatus @default(PENDING)
  result      Json?
  modelUsed   String?     @map("model_used")
  createdAt   DateTime    @default(now()) @map("created_at")
  completedAt DateTime?   @map("completed_at")
  createdById String      @map("created_by_id") @db.Uuid

  matter    Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  firm      Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  createdBy User   @relation("BriefCreatedBy", fields: [createdById], references: [id])

  @@index([matterId])
  @@index([firmId])
  @@index([status])
  @@map("research_briefs")
}

model Draft {
  id          String      @id @default(uuid()) @db.Uuid
  firmId      String      @map("firm_id") @db.Uuid
  matterId    String?     @map("matter_id") @db.Uuid
  type        DraftType
  title       String
  content     String      @default("")
  status      DraftStatus @default(DRAFT)
  instructions String?
  modelUsed   String?     @map("model_used")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  createdById String      @map("created_by_id") @db.Uuid

  firm      Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matter    Matter? @relation(fields: [matterId], references: [id], onDelete: SetNull)
  createdBy User    @relation("DraftCreatedBy", fields: [createdById], references: [id])

  @@index([firmId])
  @@index([matterId])
  @@index([status])
  @@map("drafts")
}

model Meeting {
  id          String        @id @default(uuid()) @db.Uuid
  firmId      String        @map("firm_id") @db.Uuid
  matterId    String?       @map("matter_id") @db.Uuid
  title       String
  transcript  String?
  meetingDate DateTime      @map("meeting_date")
  source      MeetingSource @default(UPLOAD)
  status      MeetingStatus @default(PENDING)
  createdAt   DateTime      @default(now()) @map("created_at")

  firm         Firm                @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matter       Matter?             @relation(fields: [matterId], references: [id], onDelete: SetNull)
  actionItems  MeetingActionItem[]
  decisions    MeetingDecision[]

  @@index([firmId])
  @@index([matterId])
  @@index([status])
  @@map("meetings")
}

model MeetingActionItem {
  id        String           @id @default(uuid()) @db.Uuid
  meetingId String           @map("meeting_id") @db.Uuid
  text      String
  ownerId   String?          @map("owner_id") @db.Uuid
  dueDate   DateTime?        @map("due_date")
  status    ActionItemStatus @default(OPEN)
  createdAt DateTime         @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  owner   User?   @relation("ActionItemOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([ownerId])
  @@map("meeting_action_items")
}

model MeetingDecision {
  id        String   @id @default(uuid()) @db.Uuid
  meetingId String   @map("meeting_id") @db.Uuid
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_decisions")
}

model KbQuery {
  id           String   @id @default(uuid()) @db.Uuid
  firmId       String   @map("firm_id") @db.Uuid
  question     String
  matterId     String?  @map("matter_id") @db.Uuid
  answer       String?
  sourceChunks Json?    @map("source_chunks")
  confidence   Float?
  modelUsed    String?  @map("model_used")
  createdAt    DateTime @default(now()) @map("created_at")
  createdById  String   @map("created_by_id") @db.Uuid

  firm      Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matter    Matter? @relation(fields: [matterId], references: [id], onDelete: SetNull)
  createdBy User    @relation("KbQueryCreatedBy", fields: [createdById], references: [id])

  @@index([firmId])
  @@index([matterId])
  @@map("kb_queries")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  firmId       String   @map("firm_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  details      Json?
  modelUsed    String?  @map("model_used")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Playbook {
  id          String   @id @default(uuid()) @db.Uuid
  firmId      String   @map("firm_id") @db.Uuid
  name        String
  description String?
  rules       Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@map("playbooks")
}

model Job {
  id          String    @id @default(uuid()) @db.Uuid
  firmId      String    @map("firm_id") @db.Uuid
  type        JobType
  status      JobStatus @default(PENDING)
  result      Json?
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([status])
  @@index([type])
  @@map("jobs")
}

// ─── CA Vertical Models ──────────────────────────────────────────────────────

model Client {
  id          String    @id @default(uuid()) @db.Uuid
  firmId      String    @map("firm_id") @db.Uuid
  name        String
  pan         String?   @map("pan")
  gstin       String?   @map("gstin")
  tan         String?   @map("tan")
  cin         String?   @map("cin")
  contactName String?   @map("contact_name")
  email       String?
  phone       String?
  address     String?
  status      String    @default("active")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  firm         Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  engagements  Engagement[]
  filings      Filing[]
  reconciliations Reconciliation[]

  @@unique([firmId, pan])
  @@unique([firmId, gstin])
  @@index([firmId])
  @@map("clients")
}

model Engagement {
  id          String           @id @default(uuid()) @db.Uuid
  firmId      String           @map("firm_id") @db.Uuid
  clientId    String           @map("client_id") @db.Uuid
  type        EngagementType   @map("type")
  status      EngagementStatus @default(ACTIVE) @map("status")
  name        String           @map("name")
  description String?
  startDate   DateTime         @map("start_date")
  endDate     DateTime?        @map("end_date")
  fee         Decimal?         @db.Decimal(12, 2) @map("fee")
  signingCAId String?          @map("signing_ca_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  firm       Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  filings    Filing[]

  @@index([firmId])
  @@index([clientId])
  @@index([status])
  @@map("engagements")
}

model Filing {
  id              String       @id @default(uuid()) @db.Uuid
  firmId          String       @map("firm_id") @db.Uuid
  clientId        String       @map("client_id") @db.Uuid
  engagementId    String?      @map("engagement_id") @db.Uuid
  type            FilingType   @map("type")
  status          FilingStatus @default(DRAFT) @map("status")
  period          String       @map("period")
  dueDate         DateTime     @map("due_date")
  filedDate       DateTime?    @map("filed_date")
  filedBy         String?      @map("filed_by") @db.Uuid
  dscUsed         String?      @map("dsc_used") @db.Uuid
  udin            String?      @map("udin")
  data            Json?        @map("data")
  provenance      Json?        @map("provenance")
  partnerReviewBy String?      @map("partner_review_by") @db.Uuid
  partnerReviewAt DateTime?    @map("partner_review_at")
  notes           String?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  firm       Firm        @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  engagement Engagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)

  @@index([firmId])
  @@index([clientId])
  @@index([status])
  @@index([dueDate])
  @@map("filings")
}

model ComplianceItem {
  id          String             @id @default(uuid()) @db.Uuid
  firmId      String             @map("firm_id") @db.Uuid
  clientId    String?            @map("client_id") @db.Uuid
  type        ComplianceItemType @map("type")
  status      ComplianceStatus   @default(UPCOMING) @map("status")
  title       String
  description String?
  dueDate     DateTime           @map("due_date")
  completedAt DateTime?          @map("completed_at")
  severity    String             @default("normal") @map("severity")
  metadata    Json?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([firmId])
  @@index([dueDate])
  @@index([status])
  @@map("compliance_items")
}

model Reconciliation {
  id              String               @id @default(uuid()) @db.Uuid
  firmId          String               @map("firm_id") @db.Uuid
  clientId        String               @map("client_id") @db.Uuid
  status          ReconciliationStatus @default(PENDING) @map("status")
  period          String               @map("period")
  trialBalanceRef String?              @map("trial_balance_ref")
  bankStmtRef     String?              @map("bank_stmt_ref")
  totalEntries    Int?                 @map("total_entries")
  matchedEntries  Int?                 @map("matched_entries")
  varianceAmount  Decimal?             @db.Decimal(15, 2) @map("variance_amount")
  flaggedItems    Json?                @map("flagged_items")
  result          Json?
  agentCrew       String?              @map("agent_crew")
  provenanceTrack Json?                @map("provenance_track")
  reviewedBy      String?              @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?            @map("reviewed_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([clientId])
  @@index([status])
  @@map("reconciliations")
}

model DSCKey {
  id          String   @id @default(uuid()) @db.Uuid
  firmId      String   @map("firm_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  label       String
  certSerial  String   @map("cert_serial")
  issuedBy    String   @map("issued_by")
  validFrom   DateTime @map("valid_from")
  validUntil  DateTime @map("valid_until")
  isActive    Boolean  @default(true) @map("is_active")
  publicKeyHash String? @map("public_key_hash")
  createdAt   DateTime @default(now()) @map("created_at")

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@unique([firmId, certSerial])
  @@index([firmId])
  @@map("dsc_keys")
}
