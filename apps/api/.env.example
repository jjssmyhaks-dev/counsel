# ─── Server ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Auth ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-here

# ─── Database (Neon PostgreSQL / any Postgres + pgvector) ──
DATABASE_URL=postgresql://user:***@host:5432/dbname?sslmode=require

# ─── AI Service ────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ─── SSO (WorkOS) ──────────────────────────────────────────
WORKOS_API_KEY=***
WORKOS_CLIENT_ID=client_xxxxxxxx
WORKOS_REDIRECT_URI=http://localhost:3001/api/v1/auth/callback

# ─── Frontend URL (for CORS / callbacks) ───────────────────
FRONTEND_URL=http://localhost:3000

# ─── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=***

# ═══ Integration APIs (all optional — feature gated) ═══════

# ─── Cloudflare R2 Storage ─────────────────────────────────
R2_ACCESS_KEY_ID=***
R2_SECRET_ACCESS_KEY=***
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=counsel-documents
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# ─── OAuth Encryption ──────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_ENCRYPTION_KEY=***

# ─── Google Workspace (Gmail + Calendar + Drive) ───────────
GOOGLE_CLIENT_ID=***.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=***

# ─── Microsoft 365 (Outlook + Calendar + OneDrive + Teams) ─
MICROSOFT_CLIENT_ID=***
MICROSOFT_CLIENT_SECRET=***

# ─── DocuSign eSignature ───────────────────────────────────
DOCUSIGN_INTEGRATION_KEY=***
DOCUSIGN_SECRET_KEY=***
DOCUSIGN_ACCOUNT_ID=***
DOCUSIGN_HMAC_KEY=***
DOCUSIGN_ENVIRONMENT=demo

# ─── Salesforce CRM ────────────────────────────────────────
SALESFORCE_CLIENT_ID=***
SALESFORCE_CLIENT_SECRET=***

# ─── QuickBooks Online ─────────────────────────────────────
QUICKBOOKS_CLIENT_ID=***
QUICKBOOKS_CLIENT_SECRET=***

# ─── Slack ─────────────────────────────────────────────────
SLACK_CLIENT_ID=***
SLACK_CLIENT_SECRET=***

# ─── Zoom ──────────────────────────────────────────────────
ZOOM_CLIENT_ID=***
ZOOM_CLIENT_SECRET=***
